---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getPosts, topicSlug, dateLabel, readingTime } from '../../lib/posts';
export async function getStaticPaths() { return (await getPosts()).map(post => ({ params: { id: post.id }, props: { post } })); }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const related = (await getPosts()).filter(p => p.id !== post.id && p.data.tags.some(tag => post.data.tags.includes(tag))).slice(0, 3);
---
<Layout title={post.data.title} description={post.data.description} section="Writing">
  <article>
    <a href="/writing/" class="back-link">← All writing</a>
    <header class="article-header">
      <h1>{post.data.title}</h1>
      <div class="post-meta"><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time><span>·</span><span>{readingTime(post)} min read</span>{post.data.sample && <span class="sample-badge">Sample essay</span>}</div>
      <div class="topic-pills">{post.data.tags.map(tag => <a href={`/topics/${topicSlug(tag)}/`}><span>#</span>{tag}</a>)}</div>
      {headings.filter(h => h.depth === 2).length > 1 && <details class="table-of-contents"><summary>In this note</summary><ul>{headings.filter(h => h.depth === 2).map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></details>}
      <p class="article-deck">{post.data.description}</p>
    </header>
    <div class="prose"><Content /></div>
    <div class="article-end"><p>Thanks for reading.</p><a href="/rss.xml">Follow via RSS ↗</a></div>
  </article>
  {related.length > 0 && <section class="related-notes"><div class="section-heading"><h2>Connected ideas</h2></div><ul>{related.map(p => <li><a href={`/writing/${p.id}/`}>{p.data.title}<span aria-hidden="true">↗</span></a></li>)}</ul></section>}
</Layout>
